name: Update YouTube videos

on:
  schedule:
    - cron: "17 * * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Fetch latest original MVs
        run: |
          python - <<'PY'
          import json
          import urllib.request
          import xml.etree.ElementTree as ET

          playlist_id = "PLpSvmeL1f95wgDv-wDC9G1w_axX6ab3f4"
          url = (
              "https://www.youtube.com/feeds/videos.xml"
              f"?playlist_id={playlist_id}"
          )

          request = urllib.request.Request(
              url,
              headers={"User-Agent": "Mozilla/5.0"}
          )

          with urllib.request.urlopen(request, timeout=30) as response:
              root = ET.fromstring(response.read())

          ns = {
              "atom": "http://www.w3.org/2005/Atom",
              "yt": "http://www.youtube.com/xml/schemas/2015",
              "media": "http://search.yahoo.com/mrss/",
          }

          videos = []

          for entry in root.findall("atom:entry", ns):
              video_id = entry.findtext(
                  "yt:videoId", namespaces=ns
              )
              title = entry.findtext(
                  "atom:title", namespaces=ns
              )
              published = entry.findtext(
                  "atom:published", namespaces=ns
              )

              thumb = entry.find(
                  "media:group/media:thumbnail", ns
              )

              if video_id and title:
                  videos.append({
                      "id": video_id,
                      "title": title,
                      "url": (
                          "https://www.youtube.com/watch?v="
                          + video_id
                      ),
                      "thumbnail": (
                          thumb.get("url")
                          if thumb is not None
                          else (
                              "https://i.ytimg.com/vi/"
                              + video_id
                              + "/hqdefault.jpg"
                          )
                      ),
                      "published": published or "",
                  })

          videos.sort(
              key=lambda video: video["published"],
              reverse=True
          )

          videos = videos[:3]

          if not videos:
              raise SystemExit(
                  "動画が取得できなかったため、更新を中止しました。"
              )

          with open(
              "videos.json", "w", encoding="utf-8"
          ) as f:
              json.dump(
                  videos, f, ensure_ascii=False, indent=2
              )
              f.write("\n")

          print(f"{len(videos)}件の動画を保存しました。")
          PY

       - name: Save changes
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add videos.json
          if ! git diff --cached --quiet; then
            git commit -m "Update latest YouTube videos"
            git push
          fi
